<?xml version="1.0" encoding="utf-8"?>
<!--
    AllergyTrack — Monochromatická ikona jako Android Vector Drawable
    res/drawable/ic_launcher_monochrome.xml

    Systém (Android 13+) při themed icons:
      1. Vezme tento drawable
      2. Aplikuje jednu barvu z uživatelovy tapety (Material You)
      3. Zobrazí na pozadí odvozeném z tapety

    Canvas: 108×108 dp (standard adaptive icon)
    Safe zone: 72×72 dp (18dp padding každou stranu)
    Ikona je vycentrována a vejde se do safe zone.
-->
